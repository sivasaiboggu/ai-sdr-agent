# Copy to .env and fill in. Never commit a real .env with keys.
# Everything below is FREE tier / mock fallback — no paid API is required
# for the core demo. Paid integrations are optional and clearly marked.
# Gemini (writer / research summariser) — FREE tier; mock fallback if unset.
GEMINI_API_KEY=
# Apollo (people / verified emails) — FREE credits; verified seed data if unset.
APOLLO_API_KEY=
# Gmail sending — FREE. Dry-run by default. Set to true only to send real mail.
# Real sends ALSO need GMAIL_APP_PASSWORD below; without it, sends are
# logged as failed and nothing goes out. POST /approve with this still
# false stays a dry-run, so nothing can be sent by accident.
GMAIL_SEND_ENABLED=false
GMAIL_FROM=sivasaiboggu@gmail.com
# Gmail app password — create it at Google Account > Security >
# 2-Step Verification > App passwords (needs 2-Step on). Your normal
# Google password does NOT work with SMTP. Never commit a real value.
GMAIL_APP_PASSWORD=
# Database: SQLite (FREE, default). Set a Postgres URL to use Postgres
# instead — backend/app/memory.py creates the schema on first connect,
# and SQLite remains the fallback when this is unset or a sqlite:// URL.
# Example: DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/sdr
DATABASE_URL=sqlite:///./sdr.db
# Send gap between cold mails, in seconds (user rule: 300 = 5 minutes).
SEND_GAP_SECONDS=300
# --- Backend hosting ---
# Comma-separated origins allowed to call the API from a browser. Local dev
# defaults are http://localhost:5173,http://localhost:3000. When the frontend
# is deployed (e.g. Vercel), add its origin here or the browser blocks
# every API call (CORS preflight fails).
# Example: CORS_ORIGINS=https://ai-sdr-agent.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Port the API listens on. Hosts like Render set PORT themselves — the
# start command should honour it, e.g. `uvicorn backend.app.api:app
# --host 0.0.0.0 --port $PORT`.
PORT=8000
# Resume attached to every mail.
RESUME_PATH=workspace/your_files/sivasai-boggu-ats-resume/Sivasai_Boggu_Resume.pdf
# --- WhatsApp (FREE) ---
# Meta WhatsApp Cloud API — free tier (1,000 service conversations/month free).
# Get these at developers.facebook.com > WhatsApp > API Setup (free, no card).
WHATSAPP_VERIFY_TOKEN=sdr-agent-verify
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Twilio WhatsApp Sandbox — FREE test path, no approval needed.
# Get these at twilio.com/console (free trial) > Messaging > Try WhatsApp.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
