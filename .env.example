# Copy to .env and fill in. Never commit a real .env with keys.
# Everything below is FREE tier / mock fallback — no paid API is required
# for the core demo. Paid integrations are optional and clearly marked.
# Gemini (writer / research summariser) — FREE tier; mock fallback if unset.
GEMINI_API_KEY=
# Apollo (people / verified emails) — FREE credits; verified seed data if unset.
APOLLO_API_KEY=
# Gmail sending — FREE. Dry-run by default. Set to true only to send real mail.
GMAIL_SEND_ENABLED=false
GMAIL_FROM=sivasaiboggu@gmail.com
# Database: SQLite (FREE, default). Set a Postgres URL only if you want it.
DATABASE_URL=sqlite:///./sdr.db
# Send gap between cold mails, in seconds (user rule: 300 = 5 minutes).
SEND_GAP_SECONDS=300
# Resume attached to every mail.
RESUME_PATH=workspace/your_files/sivasai-boggu-ats-resume/Sivasai_Boggu_Resume.pdf
# --- WhatsApp (FREE) ---
# Meta WhatsApp Cloud API — free tier (1,000 service conversations/month free).
# Get these at developers.facebook.com > WhatsApp > API Setup (free, no card).
WHATSAPP_VERIFY_TOKEN=sdr-agent-verify
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Twilio WhatsApp Sandbox — FREE test path, no approval needed.
# Get these at twilio.com/console (free trial) > Messaging > Try WhatsApp.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
