# Copy to .env.local for local dev, or set in Vercel (Project Settings →
# Environment Variables) for a deployed frontend. Never commit a real
# .env.local with secrets — this file documents the only variable the
# frontend reads.
#
# VITE_API_URL — where the FastAPI backend lives (no trailing slash,
# no /api suffix). Examples:
#   Local dev: leave unset — the Vite dev server proxies /api/* to
#   http://localhost:8000 (see vite.config.ts).
#   Production: VITE_API_URL=https://ai-sdr-agent-api.onrender.com
# If this is unset in a production build, the dashboard calls /api/*
# on its own origin, which only works if that host proxies /api to the
# backend — Vercel does not by default, so set it when deploying.
VITE_API_URL=
